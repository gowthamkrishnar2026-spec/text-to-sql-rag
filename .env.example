# Copy this file to .env and fill in your key:  cp .env.example .env

# --- Google Gemini (the only external service) -------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# --- PostgreSQL ---------------------------------------------------------------
# Docker Compose overrides POSTGRES_SERVER to "postgres" automatically.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=text2sql_db

# --- Frontend -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Optional RAG tuning (defaults shown; see backend/RAG.md) ---------------------
# RAG_SCHEMA_ENABLED=true
# RAG_SCHEMA_TOP_K=4
# RAG_SCHEMA_MAX_TABLES=6
# RAG_EXAMPLES_ENABLED=true
# RAG_EXAMPLES_TOP_K=4
# RAG_EXAMPLE_SOURCES=project
